  "technicalRequirement": {
    "valueTypes": ["BOOLEAN", "ENUM", "STRING", "STRING_SET", "QUANTITY", "RANGE"],
    "valueStates": ["KNOWN", "UNKNOWN", "CONFLICTED", "NOT_APPLICABLE"],
    "priorities": ["HARD", "SOFT"],
    "operators": ["EQ", "GTE", "LTE", "IN", "CONTAINS_ALL", "BETWEEN"],
    "evidenceBound": true
  },
  "limits": {
    "productFamilies": 20,
    "requirements": 100,
    "evidenceRefsPerRequirement": 10,
    "conditions": 20
  },
  "nonClaims": [
    "A project opportunity is not one company or account.",
    "No model-provided field can decide fit, verification status, customer use, or final pursuit."
