{
  "name": "b2b-lead-agent",
  "version": "1.0.0",
  "description": "Evidence-first industrial pursuit system for synthetic fit evaluation and public-source candidate review",
  "main": "main.js",
  "scripts": {
    "start": "node main.js --profile danfoss",
    "email": "node scripts/notify-lead-publication.mjs",
    "check:naming": "node scripts/check-naming.js",
    "check:schema": "node scripts/check-d1-schema-consistency.js",
    "check:golden-dataset": "node --test tests/golden-dataset.test.js tests/golden-dataset-lineage-v1.test.js tests/golden-dataset-cli.test.js tests/golden-generated-artifacts.test.js tests/golden-human-review-batch.test.js tests/golden-human-review-proposal.test.js tests/golden-human-review-approval.test.js tests/golden-human-review-batch-02.test.js tests/golden-human-review-proposal-02.test.js tests/golden-human-review-approval-02.test.js && npm run check:golden-artifacts",
    "check:golden-artifacts": "node scripts/check-pursuit-golden-generated-artifacts.mjs",
    "prepare:golden-review-batch": "node scripts/prepare-pursuit-golden-human-review.mjs --json --quiet --output tmp/codex/pursuit-golden-human-review-batch-01.json",
    "prepare:golden-review-proposal": "node scripts/prepare-pursuit-golden-human-review-proposal.mjs --quiet --output tmp/codex/pursuit-golden-human-review-batch-01-proposal.json --markdown-output docs/roadmap/pursuit-golden-human-review-batch-01-proposal.md",
    "prepare:golden-review-batch-02": "node scripts/prepare-pursuit-golden-human-review-batch-02.mjs --quiet --output tmp/codex/pursuit-golden-human-review-batch-02.json",
    "prepare:golden-review-proposal-02": "node scripts/prepare-pursuit-golden-human-review-proposal-02.mjs --quiet --output tmp/codex/pursuit-golden-human-review-batch-02-proposal.json --markdown-output docs/roadmap/pursuit-golden-human-review-batch-02-proposal.md",
    "evidence:packet": "node scripts/generate-release-evidence-packet.js",
    "proof:level1:preflight": "node scripts/level1-proof-preflight.mjs --json --output tmp/codex/level1-proof-preflight-automation-non-production-evidence.json",
    "proof:level1:approval-dry-run": "node scripts/level1-production-proof-approval-dry-run.mjs --json --output tmp/codex/level1-production-proof-approval-dry-run-non-production-evidence.json",
    "proof:level1:change-control-manifest": "node scripts/level1-production-proof-change-control-manifest.mjs --json --output tmp/codex/level1-production-proof-change-control-manifest-non-production-plan.json",
    "proof:level1:operator-rehearsal": "node scripts/level1-operator-rehearsal.mjs --json --output tmp/codex/level1-operator-rehearsal-non-production-runbook.json",
    "proof:level1:closure-dashboard": "node scripts/level1-readiness-closure-dashboard.mjs --json --output tmp/codex/level1-readiness-closure-dashboard-non-production.json --markdown --markdown-output docs/roadmap/b2b-lead-agent-level-1-readiness-closure-dashboard-non-production.md",
    "proof:level1:approval-intake": "node scripts/level1-production-proof-approval-intake-gate.mjs --json --output tmp/codex/level1-production-proof-approval-intake-gate-non-production.json --template-output docs/roadmap/b2b-lead-agent-level-1-production-proof-approval-intake-template-non-production.json --markdown-output docs/roadmap/b2b-lead-agent-level-1-production-proof-approval-intake-gate-non-production.md",
    "proof:level1:post-approval-simulator": "node scripts/level1-post-approval-decision-simulator.mjs --json --output tmp/codex/level1-post-approval-decision-simulator-non-production.json --markdown --markdown-output docs/roadmap/b2b-lead-agent-level-1-post-approval-decision-simulator-non-production.md",
    "security:audit-current": "npm audit --omit=dev --audit-level=moderate",
    "security:audit-triage": "node scripts/security-dependency-audit-triage.mjs --json --output tmp/codex/security-dependency-audit-triage-non-production.json",
    "check:enrichment-boundary": "node --test tests/enrichment-outbound-http-boundary.test.js && node scripts/outbound-http-enrichment-boundary-audit.mjs --json --output tmp/codex/outbound-http-enrichment-boundary-guards-non-production.json",
    "check:enrichment-replay": "node --test tests/enrichment-fixture-replay.test.js && node scripts/enrichment-fixture-replay.mjs --json --output tmp/codex/enrichment-fixture-replay-output-contract-non-production.json",
    "audit:claims": "node scripts/audit-evidence-claims.mjs --json --fail-on-violations",
    "eval:spec-fit": "node scripts/evaluate-spec-fit.mjs --fixtures --json --repeat 2",
    "eval:pursuit-twin": "node scripts/evaluate-pursuit-twin-v0.mjs --json --repeat 2",
    "eval:pursuit-value-pilot": "node scripts/evaluate-pursuit-value-pilot-v0.mjs",
    "prepare:pursuit-value-pilot": "node scripts/prepare-pursuit-value-pilot-v0.mjs",
    "validate:pursuit-value-pilot": "node scripts/validate-pursuit-value-pilot-v0.mjs",
    "check:pursuit-value-pilot": "node --test tests/pursuit-value-pilot-v0.test.js tests/pursuit-value-pilot-offline-html.test.js tests/pursuit-value-pilot-v0-files.test.js tests/pursuit-value-pilot-v0-cli.test.js && npm run eval:pursuit-value-pilot",
    "measure:claim-spec-fit": "node scripts/measure-claim-spec-fit-performance.mjs",
    "test:claim-spec-fit": "node --test tests/evidence-claim-registry.test.js tests/legacy-claim-audit.test.js tests/specification-fit-engine.test.js tests/pursuit-dossier.test.js tests/pursuit-twin-v0.test.js tests/pursuit-twin-v0-cli.test.js tests/pursuit-value-pilot-v0.test.js tests/trusted-reference-prompt-projection.test.js tests/claim-spec-cli.test.js tests/claim-spec-failure-injection.test.js tests/claim-spec-performance.test.js",
    "check:lead-pipeline-replay": "node --test tests/lead-pipeline-fixture-replay-artifact-contract.test.js && node scripts/lead-pipeline-fixture-replay.mjs --json --output tmp/codex/lead-pipeline-fixture-replay-artifact-contract-non-production.json",
    "check:reviewer-workflow-boundary": "node --test worker/tests/reviewer-workflow-boundary-audit.test.mjs tests/release-evidence-redaction.test.js && node scripts/reviewer-workflow-boundary-audit.mjs --json --output tmp/codex/reviewer-workflow-boundary-audit-non-production.json",
    "check:level1": "node --test worker/tests/local-test-auth-adapter.test.mjs worker/tests/auth-provider-session-scaffold.test.mjs worker/tests/level1-readiness-guards.test.mjs worker/tests/level1-local-proof-simulation.test.mjs worker/tests/level1-auth-route-audit.test.mjs worker/tests/manual-review-notes.test.mjs worker/tests/level1-proof-preflight.test.mjs worker/tests/level1-production-proof-approval.test.mjs worker/tests/level1-production-proof-change-control-manifest.test.mjs worker/tests/level1-operator-rehearsal.test.mjs worker/tests/level1-readiness-closure-dashboard.test.mjs worker/tests/level1-production-proof-approval-intake-gate.test.mjs worker/tests/level1-post-approval-decision-simulator.test.mjs && npm run test:evidence && npm run check:reviewer-workflow-boundary && npm run proof:level1:preflight && npm run proof:level1:approval-dry-run && npm run proof:level1:change-control-manifest && npm run proof:level1:operator-rehearsal && npm run proof:level1:approval-intake && npm run proof:level1:post-approval-simulator && npm run proof:level1:closure-dashboard",
    "eval:lead-quality": "node scripts/evaluate-lead-quality.js --fixtures",
    "e2e": "node e2e-test.mjs",
    "test:e2e:local": "node --test worker/e2e/local-e2e.test.mjs",
    "test:evidence": "node --test tests/release-evidence-redaction.test.js tests/release-evidence-packet.test.js",
    "test:root": "node --test tests/*.test.js",
    "test:runtime": "npm run test:root",
    "test:unit": "find worker/tests -maxdepth 1 -name '*.test.mjs' ! -name 'job-trigger.test.mjs' ! -name 'trigger-handler.test.mjs' ! -name 'workflow-contract.test.mjs' -print0 | xargs -0 node --test",
    "test:contract": "node --test worker/tests/job-trigger.test.mjs worker/tests/trigger-handler.test.mjs worker/tests/workflow-contract.test.mjs",
    "test:worker": "npm run test:unit && npm run test:contract",
    "test": "npm run test:root && npm run test:worker"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.18.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "nodemailer": "^9.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
