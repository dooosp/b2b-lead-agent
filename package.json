{
  "name": "b2b-lead-agent",
  "version": "1.0.0",
  "description": "B2B 리드 발굴 에이전트 - 프로필 기반 멀티 고객사",
  "main": "main.js",
  "scripts": {
    "start": "node main.js --profile danfoss",
    "email": "node main.js --profile danfoss --email",
    "check:naming": "node scripts/check-naming.js",
    "e2e": "node e2e-test.mjs",
    "test:unit": "find worker/tests -maxdepth 1 -name '*.test.mjs' ! -name 'job-trigger.test.mjs' ! -name 'trigger-handler.test.mjs' ! -name 'workflow-contract.test.mjs' -print0 | xargs -0 node --test",
    "test:contract": "node --test worker/tests/job-trigger.test.mjs worker/tests/trigger-handler.test.mjs worker/tests/workflow-contract.test.mjs",
    "test:worker": "npm run test:unit",
    "test": "npm run test:unit && npm run test:contract"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.12",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
